# Copy to .env and fill in. Never commit .env.

# Meta Model API (https://api.meta.ai/v1, Bearer auth)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# Open-weight path (Muse Spark Open). With a Baseten key the fix-plan agent runs on Muse Spark
# Open and falls back to hosted Muse Spark; AGENT_PROVIDER=meta keeps it on hosted only.
BASETEN_API_KEY=
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026
AGENT_PROVIDER=baseten
# Muse Image "after" pictures for the top fixes (0 turns them off; $0.01 each)
AFTER_IMAGES=3
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
FIREWORKS_API_KEY=

# Database (Postgres: Neon or Supabase)
DATABASE_URL=
# Local PGlite only: 0 starts with no sample community
SEED_SAMPLE=

# Object storage for uploads and frames
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Spend control: a run stops before exceeding this estimated cost (USD)
SPEND_LIMIT_USD_PER_RUN=0.50
# Muse Spark Open on Baseten bills partner credits, with its own per-run cap
SPEND_LIMIT_USD_PARTNER_PER_RUN=0.30
# Privacy guard: raw and intermediate videos are deleted when a scan ends. 1 keeps them
# (local debugging only; never in a deployment).
KEEP_RAW_VIDEO=0
# Account-wide caps (the Meta account has no hard cap). New scans are refused when a scan's
# worst case would break the rolling 24 h cap or the all-time cap.
SPEND_LIMIT_USD_PER_DAY=5
SPEND_LIMIT_USD_TOTAL=50
MAX_CONCURRENT_SCANS=2
# Web app: if set, starting a scan needs this passcode (browsing stays open)
SCAN_PASSCODE=
