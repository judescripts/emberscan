# Copy to .env and fill in. Never commit .env.

# Meta Model API (https://api.meta.ai/v1, Bearer auth)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1

# Open-weight path (Muse Spark Open). Fill whichever provider is used.
BASETEN_API_KEY=
BASETEN_MODEL_ID=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
FIREWORKS_API_KEY=

# Database (Postgres: Neon or Supabase)
DATABASE_URL=

# Object storage for uploads and frames
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Spend control: a run stops before exceeding this estimated cost (USD)
SPEND_LIMIT_USD_PER_RUN=0.50
